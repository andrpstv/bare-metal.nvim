# config-local tool binaries (platform-specific, install via :DistroTools).
# NOTE: per-tool .gitkeep files do NOT work under this rule (parent dirs excluded);
# install_tool creates tools/<name>/ on demand, no placeholders needed.
tools/*/**
# OpenClaw agent workspace files — these describe the assistant operating this
# config, not the distro itself. They live at the repo root because this repo IS
# the OpenClaw workspace; they must never reach consumers.
/AGENTS.md
/SOUL.md
/USER.md
/IDENTITY.md
/BOOTSTRAP.md
/memory/
/MEMORY.md
